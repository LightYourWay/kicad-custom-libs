# Ignore list for KiCAD Projects
# Temporary files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.sch-bak
*~
_autosave-*
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cachep
# Netlist files (exported from Eeschema)
*.net
# Autorouter files (exported from Pcbnew)
*.dsn
*.ses

# Ignore DS files
.DS_Store

# Holds a personal Part-DB API token, generate it with scripts/init-partdb-lib.py
symbol/Part-DB.kicad_httplib

# Python bytecode cache
__pycache__/
